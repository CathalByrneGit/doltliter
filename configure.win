#!/bin/sh
# doltliter (Windows): write src/Makevars.win.
#
# Windows deliberately prefers the *vendored amalgamation* over the prebuilt
# release library, which is the reverse of the Unix ordering. The reason is in
# the release artifacts: doltlite-lib-win-x64-<ver>.zip ships only
# libdoltlite.dll -- no static archive and, more importantly, no .lib/.dll.a
# import library -- so there is nothing Rtools can link against directly, and a
# DLL that must then be found at runtime is a worse deal than a one-minute
# compile. See docs/feasibility-notes.md section 3.
#
# DOLTLITER_STRATEGY=system still works if you have a MinGW-built libdoltlite.

PKG=doltliter
DEFAULT_VERSION=`cat tools/doltlite-version.txt 2>/dev/null || echo 0.50.3`
DOLTLITE_VERSION=${DOLTLITE_VERSION-$DEFAULT_VERSION}
DOLTLITE_VERSION=`echo "$DOLTLITE_VERSION" | sed 's/^v//' | tr -d ' \n\r'`
STRATEGY=${DOLTLITER_STRATEGY-auto}

if [ -z "$R_HOME" ]; then
  R_HOME=`R RHOME`
fi
RBIN="${R_HOME}/bin/R"

CC=`"$RBIN" CMD config CC`
CFLAGS=`"$RBIN" CMD config CFLAGS`
CPPFLAGS=`"$RBIN" CMD config CPPFLAGS`

LOG=config.log
: > "$LOG"

say()  { echo "$PKG: $*"; }
die()  { echo "$PKG: $*" >&2; exit 1; }

WIN_SYSLIBS="-lws2_32 -lbcrypt -lcrypt32"

VENDOR_OBJECTS=""
FOUND_CPPFLAGS=""
FOUND_LIBS=""
CHOSEN=""

find_vendor() {
  [ -f src/doltlite/doltlite.c ] || return 1
  [ -f src/doltlite/doltlite.h ] || return 1
  say "using the vendored DoltLite amalgamation in src/doltlite"

  _v="$DOLTLITE_VERSION"
  # Deliberately not named VERSION: src/doltlite is on the include path, and
  # on a case-insensitive filesystem clang resolves libc++'s #include <version>
  # to it and tries to compile the version string as C++.
  if [ -f src/doltlite/doltlite_version.txt ]; then
    _v=`sed 's/^v//' src/doltlite/doltlite_version.txt | tr -d ' \n\r'`
  fi

  cat > src/doltlite_amalgamation.c <<EOF
/* Generated by configure.win -- do not edit. */
#ifndef DOLTLITE_VERSION
# define DOLTLITE_VERSION "v${_v}"
#endif
#include "doltlite/doltlite.c"
EOF

  VENDOR_OBJECTS="doltlite_amalgamation.o"
  FOUND_CPPFLAGS="-I./doltlite"
  FOUND_LIBS=""
  return 0
}

find_system() {
  for _p in $DOLTLITE_HOME /mingw64 /usr/local /usr; do
    [ -n "$_p" ] || continue
    [ -f "$_p/include/doltlite.h" ] || continue
    if [ -f "$_p/lib/libdoltlite.a" ]; then
      say "using $_p/lib/libdoltlite.a"
      FOUND_CPPFLAGS="-I$_p/include"
      FOUND_LIBS="$_p/lib/libdoltlite.a"
      return 0
    fi
    if [ -f "$_p/lib/libdoltlite.dll.a" ]; then
      say "using the import library $_p/lib/libdoltlite.dll.a"
      FOUND_CPPFLAGS="-I$_p/include"
      FOUND_LIBS="-L$_p/lib -ldoltlite"
      return 0
    fi
  done
  return 1
}

attempt() {
  case "$1" in
    vendor) find_vendor && CHOSEN=vendor ;;
    system) find_system && CHOSEN=system ;;
    download)
      say "the download strategy is not supported on Windows: the published"
      say "lib zip contains only libdoltlite.dll, with no import library"
      return 1
      ;;
    *) return 1 ;;
  esac
}

HELP="
Stage the DoltLite amalgamation and reinstall:

    Rscript tools/vendor_amalgamation.R

That downloads doltlite-amalgamation-${DOLTLITE_VERSION}.zip once into
src/doltlite/ and needs no system DoltLite install. Alternatively point
DOLTLITE_HOME at a MinGW-built libdoltlite prefix."

case "$STRATEGY" in
  vendor|system|download)
    attempt "$STRATEGY" || die "strategy '$STRATEGY' could not provide libdoltlite.$HELP"
    ;;
  auto)
    attempt vendor || attempt system || die "no DoltLite source or library found.$HELP"
    ;;
  *)
    die "DOLTLITER_STRATEGY must be one of: auto, system, vendor (got '$STRATEGY')"
    ;;
esac

say "strategy:     $CHOSEN"
say "PKG_CPPFLAGS: $FOUND_CPPFLAGS"
say "PKG_LIBS:     $FOUND_LIBS $WIN_SYSLIBS"

sed -e "s|@DOLTLITE_CPPFLAGS@|$FOUND_CPPFLAGS|" \
    -e "s|@DOLTLITE_LIBS@|$FOUND_LIBS|" \
    -e "s|@DOLTLITE_OBJECTS@|$VENDOR_OBJECTS|" \
    -e "s|@DOLTLITER_STRATEGY@|$CHOSEN|" \
    src/Makevars.win.in > src/Makevars.win || die "could not write src/Makevars.win"

say "wrote src/Makevars.win"
exit 0
